import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        //Usuario introduce los inputs
        int num_envoltorios = sc.nextInt();
        int can_chicles_envol = sc.nextInt();
        int chicles = sc.nextInt();
        //Si 0 0 0 acaba el bucle
        while (num_envoltorios != 0 || can_chicles_envol != 0 || chicles != 0) {
            //Comprobar que no es una ruina
            if (can_chicles_envol >= num_envoltorios && chicles >= num_envoltorios) {
                System.out.println("RUINA");
            } else {
                int total = chicles;
                int envoltorios = chicles;
                while (envoltorios >= num_envoltorios) {
                    int nuevos = (envoltorios / num_envoltorios) * can_chicles_envol;
                    total = total + nuevos;
                    envoltorios = (envoltorios % num_envoltorios) + nuevos;
                }
                System.out.println(total + " " + envoltorios);
            }
            num_envoltorios = sc.nextInt();
            can_chicles_envol = sc.nextInt();
            chicles = sc.nextInt();
        }
        sc.close();
    }
}
